# Copy to .env to override docker-compose defaults.

# How long (days) a session's Parquet/DuckDB store is kept on disk before
# being purged at app startup.
SDP_STORE_TTL_DAYS=7

# Optional: a folder of <sensor_id>.json/.csv files to use instead of the
# bundled sample_data/generic (generic pipeline only). Leave unset to use the
# bundled sample.
SENSOR_DATA_DIR=
