# Copy to .env to override docker-compose defaults.

# Session storage TTL (days) - how long to keep data before cleanup
SDP_STORE_TTL_DAYS=30

# Frontend API URL (production only, used in docker-compose.prod.yml)
# For local server deployment, use your server IP
# Examples:
#   FRONTEND_API_URL=http://192.168.1.100:8000   (local network)
#   FRONTEND_API_URL=http://localhost:8000        (localhost)
FRONTEND_API_URL=http://localhost:8000
